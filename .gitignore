# Build output. `dist/` is the bundle; `bin/` is the CLI entry and the shim stubs
# beside it, written by `build.config.ts`'s `end` hook because the bundler empties
# `dist/` and §10.7 wants files a read-only install still has. Both are shipped by
# `files` in the manifest, which `prepack` fills in.
/bin

# Shim stubs `enable` writes beside `src/index.ts` when it runs from a source
# checkout (§10.1). The first is the POSIX one and serves every binary name
# (§14.15). The per-name list below it is §10.3's, written only when `enable` runs
# on Windows.
/src/shim-proxy.mjs
/src/npm.mjs
/src/npx.mjs
/src/pnpm.mjs
/src/pnpx.mjs
/src/yarn.mjs
/src/yarnpkg.mjs
/src/bun.mjs
/src/bunx.mjs
/src/deno.mjs
/src/aube.mjs
/src/aubr.mjs
/src/aubx.mjs
/src/nub.mjs
/src/nubx.mjs
/src/node.mjs

# What the `setup-jup` workflow's installs leave in its fixture projects. The
# manifests are committed; nothing a manager writes beside them is.
/.github/fixtures/*/node_modules
/.github/fixtures/*/.yarn
/.github/fixtures/*/.pnp.*
/.github/fixtures/*/pnpm-lock.yaml
/.github/fixtures/*/package-lock.json

# Local recording for the ported Corepack suite (NOCK_ENV=record).
/test/corepack/nocks.db

.pi-subagents
.scriptc-work/
