{
  "name": "jup",
  "version": "0.6.3",
  "description": "A fast, small, zero-dependency version manager for package managers and runtimes.",
  "keywords": [
    "aube",
    "bun",
    "corepack",
    "deno",
    "node",
    "npm",
    "nub",
    "package-manager",
    "pnpm",
    "runtime",
    "upm",
    "version-manager",
    "yarn"
  ],
  "license": "MIT",
  "repository": "unjs/jup",
  "bin": {
    "corepack": "./bin/corepack.mjs",
    "jup": "./bin/jup.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "build": "obuild",
    "build:addon": "node scripts/build-addon.mjs",
    "dev": "vitest dev",
    "fmt": "automd && oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "prepack": "upm build",
    "refresh": "node scripts/refresh-table.mjs",
    "release": "upm test && upm build && changelogen --release && upm publish && git push --follow-tags",
    "test": "upm lint && upm typecheck && vitest run --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:corepack": "JUP_COREPACK_COMPAT=1 vitest run --config test/corepack/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "latest",
    "automd": "latest",
    "changelogen": "latest",
    "obuild": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "devEngines": {
    "packageManager": {
      "name": "upm",
      "version": "1.3.1",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
